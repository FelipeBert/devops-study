# Host aliases are used in groups and plays; ansible_host is the address used
# for the SSH connection.
all:
  hosts:
    web01:
      ansible_host: 172.31.3.34
    web02:
      ansible_host: 172.31.15.119
    # web03 is another web host. Its host-level SSH user overrides the
    # ansible_user inherited from the dc_oregon parent group below.
    web03:
      ansible_host: 172.31.33.68
      ansible_user: ubuntu
    db01:
      ansible_host: 172.31.12.251

  # Groups organize machines by role. Parent groups can combine child groups
  # and provide shared connection variables.
  children:
    webservers:
      hosts:
        web01:
        web02:
        # Add the web03 alias to this group so plays targeting webservers
        # include it as well.
        web03:
    dbservers:
      hosts:
        db01:
    dc_oregon:
      children:
        webservers:
        dbservers:
      vars:
        ansible_user: ec2-user
        ansible_ssh_private_key_file: client-key.pem
