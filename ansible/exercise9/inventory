# Host aliases are used in groups and plays; ansible_host is the address used
# for the SSH connection.
all:
  hosts:
    web01: 
      ansible_host: 172.31.3.34
    web02: 
      ansible_host: 172.31.15.119
    db01: 
      ansible_host: 172.31.12.251
 
  # Groups organize machines by role. Parent groups can combine child groups
  # and provide shared connection variables.
  children:
    webservers:
      hosts:
        web01:
        web02:
    dbservers:
      hosts:
        db01:
    dc_oregon:
      children:
        webservers:
        dbservers:
      vars:
        ansible_user: ec2-user
        ansible_ssh_private_key_file: client-key.pem
