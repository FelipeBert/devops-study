# Inventory aliases are referenced by groups and plays; ansible_host is the
# network address Ansible uses to connect.
all:
  hosts:
    web01:
      ansible_host: 172.31.3.34
    web02:
      ansible_host: 172.31.15.119
    web03:
      ansible_host: 172.31.33.68
      ansible_user: ubuntu
    db01:
      ansible_host: 172.31.12.251

  # Role groups make it easy to target web and database hosts independently.
  children:
    webservers:
      hosts:
        web01:
        web02:
        web03:
    dbservers:
      hosts:
        db01:
    dc_oregon:
      children:
        webservers:
        dbservers:
      vars:
        ansible_user: ec2-user
        ansible_ssh_private_key_file: client-key.pem
