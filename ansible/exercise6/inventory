# Inventory aliases are used in groups and playbooks; ansible_host is each
# machine's network address.
all:
  hosts:
    web01:
      ansible_host: 172.31.3.34
    web02:
      ansible_host: 172.31.15.119
    db01:
      ansible_host: 172.31.12.251
 
  # Groups make it possible to target hosts by role, for example "webservers".
  children:
    webservers:
      hosts:
        web01:
        web02:
    dbservers:
      hosts:
        db01:
    dc_oregon:
      # This parent group combines both roles and shares their SSH settings.
      children:
        webservers:
        dbservers:
      vars:
        ansible_user: ec2-user
        ansible_ssh_private_key_file: client-key.pem
