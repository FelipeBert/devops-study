# Exercise 1: start with a single managed host.
# An inventory names the machines Ansible can target; it does not define tasks.
all:
  hosts:
    # web01 is Ansible's friendly alias for this machine.
    web01:
      # ansible_host is the address Ansible connects to over SSH.
      ansible_host: 172.31.3.34
      # SSH account and private key used to authenticate to this host.
      ansible_user: ec2-user
      ansible_ssh_private_key_file: client-key.pem
